# Dockerfile for building the legacy AppImage (glibc 2.30 / RHEL 8)

# Pay no mind to vulnerability complaints in the image, we're not using system provided python or pip
FROM docker.io/almalinux:8@sha256:8b469a3a78515e8a18ea8fc727e6a3679e1d0c5ba6f58d5b30be3d0d9b86cffe

# Pull in required dependencies
RUN yum update -y \
    && yum groupinstall -y "Development Tools" \
    && yum install -y curl tar jq unzip

VOLUME [ "/src" ]
WORKDIR /src

# Build script is an ok enough entrypoint
ENTRYPOINT [ "./build.sh" ]
